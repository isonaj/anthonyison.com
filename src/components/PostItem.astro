---
import { formatDate, readingTime } from '../site';
import type { Post } from '../lib/feed';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="post-item">
  <p class="muted post-meta">{formatDate(post.data.publishedAt)} · {readingTime(post.body)}</p>
  <a class="post-title" href={`/${post.slug}/`}>{post.data.title}</a>
  {post.data.description && <p class="post-description">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <p class="post-tags muted">
      {post.data.tags.map((tag, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={`/tag/${tag}/`}>{tag}</a>
        </>
      ))}
    </p>
  )}
</li>
