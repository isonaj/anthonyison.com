---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { LINKEDIN_URL } from '../site';

const {
  title = 'Anthony Ison',
  description = 'Software development and DevOps. Bringing solutions to life.',
  /** The title on a share card, without the site name the browser tab carries. */
  shareTitle = title,
  /** A cover for the share card, as a site path or an absolute address. */
  image,
  type = 'website'
} = Astro.props;

/** Where the reader is, written as the prompt's working directory: `~` at home, `~/about` on the About page. */
const cwd = '~' + Astro.url.pathname.replace(/\/$/, '');

// Share cards are read by other sites, so every address in them has to be absolute.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="application/rss+xml" title="Anthony Ison" href="/rss.xml" />
    <meta property="og:site_name" content="Anthony Ison" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={type} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Anthony Ison, home">
        <span class="prompt-user">anthony@ison</span>:<span class="prompt-path">{cwd}</span>$<span class="cursor" aria-hidden="true"></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/about/">About</a>
        <a href={LINKEDIN_URL} rel="me">LinkedIn</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p><span class="prompt-user">anthony@ison</span>:~$ exit</p>
      <p>Software development and DevOps. Bringing solutions to life.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fbfbf8;
    --text: #1c1f1d;
    --muted: #646a66;
    --link: #0f7b4b;
    --link-soft: #0f7b4b14;
    --path: #2563eb;
    --border: #e4e4dd;
    --surface: #f2f2ed;
    --sans: 'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-family: var(--sans);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121413;
      --text: #e6e9e7;
      --muted: #949b96;
      --link: #4ade80;
      --link-soft: #4ade8014;
      --path: #60a5fa;
      --border: #262a28;
      --surface: #1a1d1b;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-size: 18px;
    line-height: 1.65;
  }

  a {
    color: var(--link);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  pre {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  code {
    font-family: var(--mono);
    font-size: 0.88em;
  }

  blockquote {
    margin-inline: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--link);
    color: var(--muted);
  }

  .site-header,
  .site-footer,
  main {
    width: min(100% - 2rem, 860px);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  /* The prompt is the site's signature: the user, then the page as a working directory. */
  .brand {
    overflow: hidden;
    color: var(--muted);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prompt-user {
    color: var(--link);
    font-weight: 600;
  }

  .prompt-path {
    color: var(--path);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    vertical-align: text-bottom;
    background: var(--link);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  nav {
    display: flex;
    flex-shrink: 0;
    gap: 1.25rem;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--link);
  }

  main {
    padding-block: 2rem 4rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .muted {
    color: var(--muted);
  }

  /* Home page introduction. */
  .hero {
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4rem);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .hero-lede {
    max-width: 40rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .button {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .button:hover,
  .button:focus-visible {
    border-color: var(--link);
    background: var(--link-soft);
    color: var(--link);
  }

  /* Feed and tag page headings. */
  .feed-label {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .feed-heading {
    margin-bottom: 0.25rem;
  }

  .feed-nav {
    margin: 0 0 1.5rem;
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  .feed-nav a {
    text-decoration: none;
  }

  .feed-nav a:hover,
  .feed-nav a:focus-visible {
    text-decoration: underline;
  }

  .post-list {
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }

  .post-item {
    display: grid;
    grid-template-columns: 6ch minmax(0, 1fr) 0;
    column-gap: 1.25rem;
    margin-inline: -0.75rem;
    padding: 0.85rem 0.75rem;
    border-radius: 8px;
    transition: background 0.15s, grid-template-columns 0.25s;
  }

  /*
   * A post opening a year carries that year's heading. One that only opens a
   * batch shows it while it heads its page, and hides it once it has been
   * appended to the feed below the rest of its year.
   */
  .post-year {
    display: none;
    grid-column: 1 / -1;
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .year-start .post-year,
  .year-continued:first-child .post-year {
    display: block;
  }

  .post-item:first-child .post-year {
    margin-top: 0;
  }

  .post-date {
    padding-top: 0.2rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .post-title {
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }

  /* The summary sits folded under the title until the reader points at, or tabs to, the post. */
  .post-more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s;
  }

  .post-more > div {
    overflow: hidden;
  }

  .post-description {
    margin: 0.35rem 0 0;
    color: var(--muted);
    line-height: 1.5;
  }

  .post-tags {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .post-tags a {
    text-decoration: none;
  }

  .post-tags a:hover,
  .post-tags a:focus-visible {
    text-decoration: underline;
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .post-item:hover,
  .post-item:focus-within {
    background: var(--link-soft);
    grid-template-columns: 6ch minmax(0, 1fr) 160px;
  }

  .post-item:hover .post-title,
  .post-item:focus-within .post-title {
    color: var(--link);
  }

  .post-item:hover .post-more,
  .post-item:focus-within .post-more {
    grid-template-rows: 1fr;
  }

  .post-item:hover .post-cover,
  .post-item:focus-within .post-cover {
    opacity: 1;
  }

  /* Without a pointer that hovers there is nothing to reveal, so show the summary outright. */
  @media (hover: none), (max-width: 640px) {
    .post-item,
    .post-item:hover,
    .post-item:focus-within {
      grid-template-columns: 6ch minmax(0, 1fr);
    }

    .post-more {
      grid-template-rows: 1fr;
    }

    .post-cover {
      display: none;
    }
  }

  /* A phone has no room for a date column, so the date sits above the title. */
  @media (max-width: 640px) {
    .post-item,
    .post-item:hover,
    .post-item:focus-within {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-date {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-item,
    .post-more,
    .post-cover {
      transition: none;
    }
  }

  .feed-marker {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
    padding-block: 2rem 1rem;
    border-top: 1px solid var(--border);
  }

  .show-more {
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .show-more:hover,
  .show-more:focus-visible {
    border-color: var(--link);
    background: var(--link-soft);
    color: var(--link);
  }

  .feed-end {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.9rem;
    text-align: center;
  }

  .is-hidden {
    display: none;
  }

  /* A post or page. */
  article {
    max-width: 720px;
  }

  .article-meta {
    margin: 0 0 0.75rem;
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .article-cover {
    width: 100%;
    margin-block: 1.5rem;
    border-radius: 8px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .article-tags a {
    display: block;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
  }

  .article-tags a:hover,
  .article-tags a:focus-visible {
    border-color: var(--link);
    background: var(--link-soft);
  }

  article h2 {
    margin-top: 2.5rem;
    font-size: 1.6rem;
  }

  article h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  article :not(pre) > code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--surface);
  }

  .article-back {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.9rem;
  }

  .article-back a {
    text-decoration: none;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer p:first-child {
    font-family: var(--mono);
  }
</style>
