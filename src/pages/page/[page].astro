---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import FeedMarker from '../../components/FeedMarker.astro';
import { getPosts, batchWithYears, batchCount } from '../../lib/feed';
import { pagePath } from '../../site';

/** Page 1 of the feed is the home page, so numbering starts at 2. */
export async function getStaticPaths() {
  const posts = await getPosts();
  const batches = batchCount(posts);
  return Array.from({ length: Math.max(0, batches - 1) }, (_, index) => {
    const batch = index + 2;
    return {
      params: { page: String(batch) },
      props: { batchPosts: batchWithYears(posts, batch), batch, batches, total: posts.length }
    };
  });
}

const { batchPosts, batch, batches, total } = Astro.props;
const previous = pagePath(batch - 1);
const next = batch < batches ? pagePath(batch + 1) : '';
---

<BaseLayout
  title={`Page ${batch} | Anthony Ison`}
  description={`Page ${batch} of ${batches} of posts by Anthony Ison.`}
>
  <p class="feed-label">All posts</p>
  <h1 class="feed-heading">Page {batch} of {batches}</h1>

  <p class="feed-nav">
    <a href={previous} rel="prev">← Newer posts</a>
  </p>

  <ul class="post-list" data-feed>
    {batchPosts.map(({ post, year }) => <PostItem post={post} year={year} />)}
  </ul>

  <FeedMarker next={next} total={total} />

  <script>
    import '../../scripts/feed';
  </script>
</BaseLayout>
