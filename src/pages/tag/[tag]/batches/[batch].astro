---
import PostItem from '../../../../components/PostItem.astro';
import FeedMarker from '../../../../components/FeedMarker.astro';
import { getPosts, postsByTag, batchOf, batchCount } from '../../../../lib/feed';
import { batchPath } from '../../../../site';

/** Batches are fragments the feed appends, not whole pages. */
export const partial = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...postsByTag(posts)].flatMap(([tag, tagged]) => {
    const total = batchCount(tagged);
    return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
      const batch = index + 2;
      return {
        params: { tag, batch: String(batch) },
        props: {
          batchPosts: batchOf(tagged, batch),
          nextBatch: batch < total ? batchPath(batch + 1, tag) : '',
          total: tagged.length,
          tag
        }
      };
    });
  });
}

const { batchPosts, nextBatch, total, tag } = Astro.props;
---

{batchPosts.map((post) => <PostItem post={post} />)}
<FeedMarker nextBatch={nextBatch} total={total} tag={tag} />
