---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import FeedMarker from '../components/FeedMarker.astro';
import { getPosts, batchOf, batchCount } from '../lib/feed';
import { pagePath } from '../site';

const posts = await getPosts();
const firstBatch = batchOf(posts, 1);
const next = batchCount(posts) > 1 ? pagePath(2) : '';
---

<BaseLayout>
  <h1 class="intro">Notes on building, running, testing, and simplifying software.</h1>

  <ul class="post-list" data-feed>
    {firstBatch.map((post) => <PostItem post={post} />)}
  </ul>

  <FeedMarker next={next} total={posts.length} />

  <script>
    import '../scripts/feed';
  </script>
</BaseLayout>
