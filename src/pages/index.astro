---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import FeedMarker from '../components/FeedMarker.astro';
import { getPosts, batchWithYears, batchCount } from '../lib/feed';
import { pagePath, LINKEDIN_URL } from '../site';

const posts = await getPosts();
const firstBatch = batchWithYears(posts, 1);
const next = batchCount(posts) > 1 ? pagePath(2) : '';
---

<BaseLayout>
  <section class="hero">
    <h1>Anthony Ison</h1>
    <p class="hero-lede">
      I started building software in 1999, before the job split into architects, analysts, designers and DevOps
      engineers. We did it all. Leading teams has since taught me a harder skill: getting more done through people
      than I ever did on the tools.
    </p>
    <p class="hero-links">
      <a class="button" href="/about/">About me →</a>
      <a class="button" href={LINKEDIN_URL} rel="me">LinkedIn</a>
      <a class="button" href="/rss.xml">RSS</a>
    </p>
  </section>

  <ul class="post-list" data-feed>
    {firstBatch.map(({ post, year }) => <PostItem post={post} year={year} />)}
  </ul>

  <FeedMarker next={next} total={posts.length} />

  <script>
    import '../scripts/feed';
  </script>
</BaseLayout>
