---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import FeedMarker from '../components/FeedMarker.astro';
import { getPosts, batchOf, batchCount } from '../lib/feed';
import { batchPath } from '../site';

const posts = await getPosts();
const firstBatch = batchOf(posts, 1);
const nextBatch = batchCount(posts) > 1 ? batchPath(2) : '';
---

<BaseLayout>
  <p class="intro">Notes on building, running, testing, and simplifying software.</p>

  <ul class="post-list" data-feed>
    {firstBatch.map((post) => <PostItem post={post} />)}
  </ul>

  <FeedMarker nextBatch={nextBatch} total={posts.length} />

  <script>
    import '../scripts/feed';
  </script>
</BaseLayout>
